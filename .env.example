# Service
APP_NAME=Cockpit Benchmark Analyzer
DATA_DIR=./data
# 2 GB default upload cap; also check reverse-proxy/client_max_body_size limits.
MAX_UPLOAD_MB=2048
# Maximum source duration accepted by the analyzer (2 hours by default).
MAX_VIDEO_DURATION_SEC=7200

# Visual evidence sampling
SAMPLE_INTERVAL_SEC=5
MAX_FRAMES=12
SAMPLING_POLICY=uniform_v1
SCENE_CHANGE_THRESHOLD=0.30
SCENE_DETECTION_TIMEOUT_SEC=180
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Audio extraction / chunking (audio is extracted even without ASR credentials).
AUDIO_ANALYSIS_SAMPLE_RATE_HZ=16000
AUDIO_CHUNK_DURATION_SEC=60
AUDIO_CHUNK_OVERLAP_SEC=1

# Optional OpenAI-compatible /audio/transcriptions endpoint.
# For OpenAI, use https://api.openai.com/v1 and a transcription-capable model.
# For a local service, use its OpenAI-compatible API base URL and model name.
AUDIO_TRANSCRIPTION_BASE_URL=
AUDIO_TRANSCRIPTION_API_KEY=
AUDIO_TRANSCRIPTION_MODEL=
AUDIO_TRANSCRIPTION_LANGUAGE=zh
AUDIO_TRANSCRIPTION_TIMEOUT_SEC=180

# Optional image-only VLM provider; audio is not yet included in this VLM call.
OPENAI_BASE_URL=
OPENAI_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_SEC=180

REQUIRE_HUMAN_REVIEW=true
