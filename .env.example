# Service
APP_NAME=Cockpit Benchmark Analyzer
DATA_DIR=./data
MAX_UPLOAD_MB=500

# Evidence sampling
SAMPLE_INTERVAL_SEC=5
MAX_FRAMES=12
# uniform_v1 preserves the original fixed-interval sampler.
# scene_aware_v1 spends up to roughly one-third of the frame budget on likely visual cuts.
# Scene detection performs an extra full decode pass; validate it on the benchmark set before adopting it.
SAMPLING_POLICY=uniform_v1
SCENE_CHANGE_THRESHOLD=0.30
SCENE_DETECTION_TIMEOUT_SEC=180
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Leave OPENAI_BASE_URL empty to run in safe no-model mode.
# Example: http://localhost:1234/v1 or an OpenAI-compatible hosted API base.
OPENAI_BASE_URL=
OPENAI_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_SEC=180

# Human review is mandatory before any result is treated as an official benchmark.
REQUIRE_HUMAN_REVIEW=true
