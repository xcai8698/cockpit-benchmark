# Service
APP_NAME=Cockpit Benchmark Analyzer
DATA_DIR=./data
MAX_UPLOAD_MB=500
SAMPLE_INTERVAL_SEC=5
MAX_FRAMES=12
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Leave OPENAI_BASE_URL empty to run in safe no-model mode.
# Example: http://localhost:1234/v1 or an OpenAI-compatible hosted API base.
OPENAI_BASE_URL=
OPENAI_API_KEY=
VLM_MODEL=
VLM_TIMEOUT_SEC=180

# Human review is mandatory before any result is treated as an official benchmark.
REQUIRE_HUMAN_REVIEW=true
